{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sergeychernov/repo-audit-skills/skills/audit-init/assets/profile.schema.json",
  "title": "AuditProfile",
  "description": "Stack profile written by audit-init into .audit/profile.json",
  "type": "object",
  "$defs": {
    "stackItemVersions": {
      "type": "array",
      "description": "Unique semver values from all package.json files; [null] when detected but version is unknown",
      "items": {
        "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
      },
      "minItems": 1
    },
    "stackItems": {
      "type": "object",
      "description": "Stack item id → unique detected versions",
      "additionalProperties": { "$ref": "#/$defs/stackItemVersions" }
    },
    "agentToolEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signals"],
      "properties": {
        "signals": {
          "type": "array",
          "description": "Matched paths (exact files) or categories (directory prefixes from markers)",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  },
  "additionalProperties": false,
  "required": ["version", "generatedAt", "generatedBy", "repo", "languages", "stack", "audit"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Profile schema version"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp when the profile was generated"
    },
    "generatedBy": {
      "type": "string",
      "format": "uri",
      "description": "Git URL of the repo-audit-skills catalog that produced this artifact"
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "root", "primaryLanguage", "monorepo", "packageJsonCount"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Repository directory name"
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute path to the git repository root"
        },
        "primaryLanguage": {
          "type": "string",
          "minLength": 1,
          "description": "Dominant language by tracked source file count"
        },
        "monorepo": {
          "type": "boolean"
        },
        "monorepoSignals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "packageJsonCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "languages": {
      "type": "object",
      "description": "Language id → tracked source file count",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime"],
      "properties": {
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "node": {
              "type": "string",
              "minLength": 1,
              "description": "Node.js version from .nvmrc, .node-version, or engines.node"
            }
          }
        },
        "packageManager": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string",
              "enum": ["npm", "yarn", "pnpm", "bun"]
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "frameworks": { "$ref": "#/$defs/stackItems" },
        "bundlers": { "$ref": "#/$defs/stackItems" },
        "testRunners": { "$ref": "#/$defs/stackItems" },
        "uiLibraries": { "$ref": "#/$defs/stackItems" },
        "componentCatalogs": { "$ref": "#/$defs/stackItems" },
        "formLibraries": { "$ref": "#/$defs/stackItems" },
        "linters": { "$ref": "#/$defs/stackItems" },
        "databases": { "$ref": "#/$defs/stackItems" }
      }
    },
    "agentTooling": {
      "type": "object",
      "description": "AI coding assistants — detected config files and rule directories (git-tracked only)",
      "additionalProperties": { "$ref": "#/$defs/agentToolEntry" }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "exclude"],
      "properties": {
        "scope": {
          "type": "string",
          "enum": ["full", "quick", "security-only", "architecture-only"]
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "description": "Path globs skipped by downstream audit skills"
        }
      }
    }
  }
}
