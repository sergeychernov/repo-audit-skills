{
  "frameworks": {
    "react": { "packages": ["react", "react-dom", "react-native"] },
    "vue": { "packages": ["vue", "nuxt", "@nuxt/kit"] },
    "angular": { "packages": ["@angular/core"] },
    "svelte": { "packages": ["svelte", "@sveltejs/kit"] },
    "nextjs": {
      "packages": [
        "next",
        "@next/env",
        "eslint-config-next",
        "@next/eslint-plugin-next"
      ],
      "files": [
        "next.config.js",
        "next.config.mjs",
        "next.config.ts",
        "next.config.mts",
        "next-env.d.ts"
      ],
      "scriptPatterns": ["\\bnext\\s+(dev|build|start|lint)\\b"]
    },
    "remix": { "packages": ["@remix-run/node", "@remix-run/react"] },
    "fastify": { "packages": ["fastify"] },
    "express": { "packages": ["express"] },
    "nestjs": { "packages": ["@nestjs/core"] },
    "hono": { "packages": ["hono"] },
    "django": { "packages": ["django"], "files": ["manage.py"] },
    "flask": { "packages": ["flask"] },
    "fastapi": { "packages": ["fastapi"] },
    "spring": { "packages": ["org.springframework:spring-core"] }
  },
  "bundlers": {
    "webpack": { "packages": ["webpack"] },
    "rspack": { "packages": ["@rspack/core", "@rsbuild/core"] },
    "vite": { "packages": ["vite"] },
    "esbuild": { "packages": ["esbuild"] },
    "rollup": { "packages": ["rollup"] },
    "parcel": { "packages": ["parcel"] },
    "turbo": { "packages": ["turbo"] }
  },
  "testRunners": {
    "jest": { "packages": ["jest", "@jest/core"] },
    "vitest": { "packages": ["vitest"] },
    "mocha": { "packages": ["mocha"] },
    "playwright": { "packages": ["@playwright/test", "playwright"] },
    "cypress": { "packages": ["cypress"] },
    "pytest": { "packages": ["pytest"] },
    "go-test": { "packages": ["testing"] }
  },
  "linters": {
    "eslint": ["eslint"],
    "prettier": ["prettier"],
    "ruff": ["ruff"],
    "golangci-lint": ["golangci-lint"]
  },
  "databases": {
    "postgres": ["pg", "postgres", "@prisma/client", "prisma"],
    "mysql": ["mysql", "mysql2"],
    "mongodb": ["mongodb", "mongoose"],
    "redis": ["redis", "ioredis"]
  }
}
